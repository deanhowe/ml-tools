#!/usr/bin/env swift

import Foundation
import Vision
import CoreImage
import AppKit

let args = CommandLine.arguments
guard args.count > 1 else {
    print("Usage: ml-faces <image>")
    exit(1)
}
if args[1] == "--help" || args[1] == "-h" {
    print("ml-faces - Detect faces in image\nUsage: ml-faces <image>")
    exit(0)
}

guard let nsImage = NSImage(contentsOfFile: args[1]),
      let cgImage = nsImage.cgImage(forProposedRect: nil, context: nil, hints: nil) else {
    print("Error: Cannot load image")
    exit(1)
}

let image = CIImage(cgImage: cgImage)
let request = VNDetectFaceRectanglesRequest { request, error in
    guard let observations = request.results as? [VNFaceObservation] else { return }
    print("Faces: \(observations.count)")
    for (i, face) in observations.enumerated() {
        print("Face \(i+1): \(Int(face.confidence * 100))%")
    }
}

try? VNImageRequestHandler(ciImage: image).perform([request])
RunLoop.main.run(until: Date(timeIntervalSinceNow: 1))
