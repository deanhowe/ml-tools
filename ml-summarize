#!/usr/bin/env swift

import Foundation
import NaturalLanguage

let args = CommandLine.arguments
guard args.count > 1 else {
    print("Usage: ml-summarize <text>")
    exit(1)
}
if args[1] == "--help" || args[1] == "-h" {
    print("ml-summarize - Extract key sentences from text\nUsage: ml-summarize <text>")
    exit(0)
}

let text = args[1...].joined(separator: " ")
let tokenizer = NLTokenizer(unit: .sentence)
tokenizer.string = text

var sentences: [String] = []
tokenizer.enumerateTokens(in: text.startIndex..<text.endIndex) { range, _ in
    sentences.append(String(text[range]))
    return true
}

let maxSentences = min(3, sentences.count)
for sentence in sentences.prefix(maxSentences) {
    print(sentence.trimmingCharacters(in: .whitespacesAndNewlines))
}
