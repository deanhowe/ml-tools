#!/bin/bash
# ml-swift-check - Quick Swift syntax/semantic check

if [[ "$1" == "--help" || "$1" == "-h" ]]; then
    echo "ml-swift-check - Check Swift code for errors"
    echo "Usage: ml-swift-check <file.swift>"
    exit 0
fi

if [[ $# -lt 1 ]]; then
    echo "Usage: ml-swift-check <file.swift>"
    exit 1
fi

FILE="$1"
if [[ ! -f "$FILE" ]]; then
    echo "Error: File not found: $FILE"
    exit 1
fi

echo "Checking: $FILE"
swiftc -typecheck "$FILE" 2>&1 | head -20
