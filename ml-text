#!/usr/bin/env swift

import Foundation
import NaturalLanguage

struct CLI {
    static func printHelp() {
        print("""
        ml-text - Local ML text processing tool
        
        USAGE:
            ml-text <command> [options]
        
        COMMANDS:
            sentiment <text>           Analyze sentiment of text
            language <text>            Detect language
            tokenize <text>            Tokenize text into words
            entities <text>            Extract named entities
            
        OPTIONS:
            --help, -h                 Show this help message
        
        EXAMPLES:
            ml-text sentiment "This is amazing!"
            ml-text language "Bonjour le monde"
            ml-text entities "Apple Inc. is in Cupertino, California"
        """)
    }
    
    static func analyzeSentiment(_ text: String) {
        let tagger = NLTagger(tagSchemes: [.sentimentScore])
        tagger.string = text
        
        let (sentiment, _) = tagger.tag(at: text.startIndex, unit: .paragraph, scheme: .sentimentScore)
        
        if let score = sentiment?.rawValue, let value = Double(score) {
            let label = value > 0.3 ? "Positive" : value < -0.3 ? "Negative" : "Neutral"
            print("Sentiment: \(label) (score: \(String(format: "%.2f", value)))")
        } else {
            print("Sentiment: Unable to determine")
        }
    }
    
    static func detectLanguage(_ text: String) {
        let recognizer = NLLanguageRecognizer()
        recognizer.processString(text)
        
        if let language = recognizer.dominantLanguage {
            print("Language: \(language.rawValue)")
        } else {
            print("Language: Unable to determine")
        }
    }
    
    static func tokenize(_ text: String) {
        let tokenizer = NLTokenizer(unit: .word)
        tokenizer.string = text
        
        print("Tokens:")
        tokenizer.enumerateTokens(in: text.startIndex..<text.endIndex) { range, _ in
            print("  - \(text[range])")
            return true
        }
    }
    
    static func extractEntities(_ text: String) {
        let tagger = NLTagger(tagSchemes: [.nameType])
        tagger.string = text
        
        let options: NLTagger.Options = [.omitWhitespace, .omitPunctuation, .joinNames]
        let tags: [NLTag] = [.personalName, .placeName, .organizationName]
        
        print("Entities:")
        tagger.enumerateTags(in: text.startIndex..<text.endIndex, unit: .word, scheme: .nameType, options: options) { tag, range in
            if let tag = tag, tags.contains(tag) {
                print("  \(tag.rawValue): \(text[range])")
            }
            return true
        }
    }
}

let args = CommandLine.arguments

guard args.count > 1 else {
    CLI.printHelp()
    exit(1)
}

let command = args[1]

if command == "--help" || command == "-h" {
    CLI.printHelp()
    exit(0)
}

guard args.count > 2 else {
    print("Error: Missing text argument")
    CLI.printHelp()
    exit(1)
}

let text = args[2...].joined(separator: " ")

switch command {
case "sentiment":
    CLI.analyzeSentiment(text)
case "language":
    CLI.detectLanguage(text)
case "tokenize":
    CLI.tokenize(text)
case "entities":
    CLI.extractEntities(text)
default:
    print("Error: Unknown command '\(command)'")
    CLI.printHelp()
    exit(1)
}
