#!/usr/bin/env swift

import Foundation
import Vision
import CoreImage
import AppKit

let args = CommandLine.arguments
guard args.count > 1 else {
    print("Usage: ml-classify <image>")
    exit(1)
}
if args[1] == "--help" || args[1] == "-h" {
    print("ml-classify - Classify image content\nUsage: ml-classify <image>")
    exit(0)
}

guard let nsImage = NSImage(contentsOfFile: args[1]),
      let cgImage = nsImage.cgImage(forProposedRect: nil, context: nil, hints: nil) else {
    print("Error: Cannot load image")
    exit(1)
}

let image = CIImage(cgImage: cgImage)
let request = VNClassifyImageRequest { request, error in
    guard let observations = request.results as? [VNClassificationObservation] else { return }
    for obs in observations.prefix(5) {
        print("\(obs.identifier): \(Int(obs.confidence * 100))%")
    }
}

try? VNImageRequestHandler(ciImage: image).perform([request])
RunLoop.main.run(until: Date(timeIntervalSinceNow: 1))
